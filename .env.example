# Copia este archivo como .env y ajusta los valores
PORT=3000
# Base de datos dedicada (créala antes con: createdb -U postgres helena)
DATABASE_URL=postgres://postgres:TU_CONTRASEÑA@localhost:5432/helena
# Cadena larga y aleatoria para firmar la cookie de sesión
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# URL pública, usada en el enlace de recuperación de contraseña
APP_URL=http://localhost:3000
